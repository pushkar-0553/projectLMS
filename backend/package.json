{
  "name": "project-learning-backend",
  "version": "1.0.0",
  "description": "Backend for Project Learning Module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup-db": "node setup-database.js",
    "setup-db:fresh": "mysql -u root -p < database/setup.sql",
    "setup-db:migrate": "mysql -u root -p < database/migrate_safe.sql",
    "migrate:v3": "mysql -u root -p < database/migrate_v3.sql",
    "migrate:v5": "node run_migration.js migration_v5_academics.sql",
    "migrate:v6": "node run_migration.js migration_v6_class_links.sql",
    "migrate:v7": "node run_migration.js migration_v7_class_link_bookmarks.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.22.0",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "node",
    "express",
    "mysql",
    "jwt",
    "lms"
  ],
  "author": "",
  "license": "MIT"
}
