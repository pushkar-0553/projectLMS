# ==============================================================================
# Written Examination Platform — Environment Configuration Template
# All secret values must be set in your secure deployment platform (e.g. Render)
# ==============================================================================

# Application Server Port
PORT=5000

# Database Configuration (MySQL 8.0-compatible / TiDB Cloud / PostgreSQL Stage)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_database
DB_SSL=true

# JSON Web Token Secret
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_EXPIRE=7d

# Cryptographic AES-256-GCM Encryption Key for SMTP & OTP protection (64 hex characters)
ENCRYPTION_KEY=your_encryption_key

# Cloudinary Storage for Question Attachments & Diagrams (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional HTTPS Email API Fallbacks for Cloud Platforms with blocked SMTP ports (Render)
# RESEND_API_KEY=re_your_api_key_here
# BREVO_API_KEY=xkeysib-your_api_key_here
# SENDGRID_API_KEY=SG.your_api_key_here

# Frontend Application Origin for Strict CORS (Vercel Production Domain)
FRONTEND_URL=your_frontend_url
